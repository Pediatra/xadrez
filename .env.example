# Caminho do executável do Stockfish.
# Se o caminho configurado não existir, a aplicação tenta /usr/bin/stockfish,
# ~/.local/bin/stockfish e, por fim, `stockfish` no PATH.
STOCKFISH_PATH=~/.local/bin/stockfish

# CLI local do Gemini 4 Hydrogen. Usa o login local da máquina (não há API key).
AGY_BIN=~/.local/bin/agy
AGY_MODEL=gemini-4-hydrogen-high
AGY_EFFORT=high
AGY_TIMEOUT_SECONDS=120
AGY_MAX_CONCURRENCY=1

# Banco local de partidas e histórico do revisor.
DATABASE_PATH=./xadrez.db

# O sandbox é ligado por padrão. Descomente a linha abaixo apenas se o
# ambiente recusar a execução em sandbox.
# AGY_SANDBOX=0
